# ================================================================
#  OmniHub Backend — environment variables
#  Copy this file to .env for local development:
#    cp .env.example .env
#  In production (Render), these are set in render.yaml / dashboard.
# ================================================================

NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/omnihub

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_PASS=change_me

# ── URLs ──────────────────────────────────────────────────────────
SERVER_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ── AI (Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Payments ──────────────────────────────────────────────────────
CHAPA_SECRET_KEY=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
CBEBIRR_MERCHANT_ID=
CBEBIRR_API_KEY=
CBEBIRR_API_SECRET=
ETB_PER_USD=55.5

# ── Telegram Mini App ─────────────────────────────────────────────
BOT_TOKEN=

# ── Email ─────────────────────────────────────────────────────────
OWNER_EMAIL=
EMAIL_FROM=
EMAIL_PASSWORD=

# ── Firebase (push notifications) ────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=

# ── KYC uploads ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads/kyc
