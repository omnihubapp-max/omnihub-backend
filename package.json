{
  "name": "omnihub-backend",
  "version": "1.0.0",
  "description": "OmniHub Super-App Backend — Bingo + Wallet + AI + Payments + USSD + Push",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start":        "node server.js",
    "dev":          "nodemon server.js",
    "dev:watch":    "nodemon --watch . --ext js,json server.js",
    "db:schema":    "psql $DATABASE_URL -f db/schema.sql",
    "db:payments":  "psql $DATABASE_URL -f db/payment_schema.sql",
    "db:additions": "psql $DATABASE_URL -f db/schema_additions.sql",
    "db:reset":     "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'",
    "test:health":  "curl http://localhost:3001/health",
    "test:ussd":    "curl 'http://localhost:3001/ussd/test?phone=+251911234567&text=1'"
  },
  "dependencies": {
    "express":                "^4.18.2",
    "socket.io":              "^4.7.2",
    "pg":                     "^8.11.3",
    "jsonwebtoken":           "^9.0.2",
    "bcryptjs":               "^2.4.3",
    "cors":                   "^2.8.5",
    "dotenv":                 "^16.3.1",
    "axios":                  "^1.6.2",
    "multer":                 "^1.4.5-lts.1",
    "sharp":                  "^0.33.2",
    "nodemailer":             "^6.9.7",
    "node-cron":              "^3.0.3",
    "@anthropic-ai/sdk":      "^0.20.0",
    "express-rate-limit":     "^7.1.5",
    "helmet":                 "^7.1.0",
    "joi":                    "^17.11.0",
    "@sentry/node":           "^7.86.0",
    "@sentry/profiling-node": "^1.3.5",
    "firebase-admin":         "^12.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
